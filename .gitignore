# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/

# uv.lock is committed on purpose, so that the exact versions are reproducible

# HAM10000 images and metadata: ~2.5 GB downloaded from Kaggle.
# Too big for git and anyone can re-download it with scripts/download_data.py
data/

# Trained weights, in either format. Reproducible by running the training,
# so nothing to version here.
*.pth
*.safetensors

# Kaggle API token. Never commit this, it is a private key to my account.
kaggle.json

# Secrets for deployment. Nothing in here has a place in a public repo.
.env
.env.*
!.env.example
*.pem
*.key

# Testing and linting caches
.pytest_cache/
.ruff_cache/
.coverage

# IDE
.idea/
.vscode/

# macOS
.DS_Store

# My working notes while going through this project's open problems: the list
# of steps I am working from and a log of what each one changed. Mine rather
# than the project's, and in Polish, so they have no place in a public repo.
notes/
